@model Bao.Models.Dashboard
@{
    ViewData["Title"] = "Admin Landing Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class=" bg-secondary container-fluid">
    <div class=" container text-lg-left py-3">
        <h1 class="display-4 py-3">Dashboard</h1>
    </div>
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h6 class="card-title">Total Products: </h6>
                        <h2 id="totalProducts" class="card-text-custom">@Model.TotalProducts</h2>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h6 class="card-title">Total Category: </h6>
                        <h2 id="totalCategory" class="card-text-custom">@Model.TotalCategory</h2>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h6 class="card-title">Total Orders of the day: </h6>
                        <h2 id="totalOrdersToday" class="card-text-custom">@Model.TotalOrdersToday</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class=" container text-lg-center py-3">
        <h3 class="py-3">Admin Panel</h3>
    </div>
    <div class="row justify-content-start">
        <div class=".col-6 col mb-4">
            <div class="card bg-secondary text-dark">
                <h6 class="card-title-custom">User Management</h6>
            </div>
            <p class="container-custom justify-content-center">This section is for you to view and manage all the users.</p>
            <div class="container-custom d-flex align-items-sm-center">
                <a class="btn btn-secondary-custom" asp-area="" asp-controller="AdminUserManagement" asp-action="UserIndex">View</a>
            </div>
        </div>
        <div class=".col-6 col mb-4">
            <div class="card bg-secondary text-dark">
                <h6 class="card-title-custom">Product Management</h6>
            </div>
            <p class="container-custom justify-content-center">This section is for you to view and manage the menu of the products.</p>
            <div class="container-custom d-flex align-items-sm-center">
                <a class="btn btn-secondary-custom" asp-area="" asp-controller="Product" asp-action="ProdCreate">Add</a>
                <a class="btn btn-secondary-custom" asp-area="" asp-controller="Product" asp-action="ProdIndex">View</a>
            </div>
        </div>
        <div class=".col-6 col mb-4">
            <div class="card bg-secondary text-dark">
                <h6 class="card-title-custom">Order Management</h6>
            </div>
            <p class="btn-container-custom justify-content-center">This section is for you to view and manage all the orders.</p>
            <div class="container-custom d-flex align-items-sm-center">
                <a class="btn btn-secondary-custom" asp-area="" asp-controller="OrderManagement" asp-action="OrderIndex">View</a>
            </div>
        </div>
    </div>
</div>