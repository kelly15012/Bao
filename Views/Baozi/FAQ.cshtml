@{
    ViewData["Title"] = "FAQ Page";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FAQ - Baozi</title>
    <link rel="stylesheet" href="~/css/faq.css">
</head>
<body>
    <div class="faq-container">
        <h1>Frequently Asked Questions testes</h1>
        <div class="faq-section">
            <h2>Products</h2>
            <div class="faq-item">
                <h3>What materials are Baozi products made of?</h3>
                <p>All Baozi products are made from high-quality, sustainable materials.</p>
            </div>
            <div class="faq-item">
                <h3>Do you offer customization options?</h3>
                <p>Yes, we offer customization options for select products. Please visit our customization page for more details.</p>
            </div>
        </div>

        <div class="faq-section">
            <h2>Shipping</h2>
            <div class="faq-item">
                <h3>What are the shipping options?</h3>
                <p>We offer standard and express shipping options. You can select your preferred option during checkout.</p>
            </div>
            <div class="faq-item">
                <h3>How long does shipping take?</h3>
                <p>Standard shipping typically takes 5-7 business days, while express shipping takes 2-3 business days.</p>
            </div>
        </div>

        <div class="faq-section">
            <h2>Returns, Changes, and Refunds</h2>
            <div class="faq-item">
                <h3>What is your return policy?</h3>
                <p>We accept returns within 30 days of purchase. Products must be in original condition and packaging.</p>
            </div>
            <div class="faq-item">
                <h3>How do I initiate a return or exchange?</h3>
                <p>To initiate a return or exchange, please contact our support team with your order details.</p>
            </div>
            <div class="faq-item">
                <h3>When will I receive my refund?</h3>
                <p>Refunds are processed within 5-7 business days after we receive your return.</p>
            </div>
        </div>
    </div>
</body>
</html>
