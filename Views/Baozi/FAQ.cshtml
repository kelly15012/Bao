@{
    ViewData["Title"] = "FAQ Page";
}

<!DOCTYPE html>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/faq.css">

<div class="container mt-5">
    <h1 class="text-center">Frequently Asked Questions</h1>
    <p class="text-center text-muted">Here are some of the most frequently asked questions</p>

    <div class="row mt-5 mb-5">
        <div class="col-md-6 mb-4">
            <div class="faq-item d-flex align-items-start">
                <div>
                    <h4>What materials are Baozi products made of?</h4>
                    <p>All Baozi products are made from high-quality, sustainable materials.</p>
                    <a href="#" class="btn btn-link p-0">Read More</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="faq-item d-flex align-items-start">
                <div>
                    <h4>Do you offer customization options?</h4>
                    <p>Yes, we offer customization options for select products. Please visit our customization page for more details.</p>
                    <a href="#" class="btn btn-link p-0">Read More</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="faq-item d-flex align-items-start">
                <div>
                    <h4>What are the shipping options?</h4>
                    <p>We offer standard and express shipping options. You can select your preferred option during checkout.</p>
                    <a href="#" class="btn btn-link p-0">Read More</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="faq-item d-flex align-items-start">
                <div>
                    <h4>How long does shipping take?</h4>
                    <p>Standard shipping typically takes 5-7 business days, while express shipping takes 2-3 business days.</p>
                    <a href="#" class="btn btn-link p-0">Read More</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="faq-item d-flex align-items-start">
                <div>
                    <h4>What is your return policy?</h4>
                    <p>We accept returns within 30 days of purchase. Products must be in original condition and packaging.</p>
                    <a href="#" class="btn btn-link p-0">Read More</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="faq-item d-flex align-items-start">
                <div>
                    <h4>How do I initiate a return or exchange?</h4>
                    <p>To initiate a return or exchange, please contact our support team with your order details.</p>
                    <a href="#" class="btn btn-link p-0">Read More</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="faq-item d-flex align-items-start">
                <div>
                    <h4>When will I receive my refund?</h4>
                    <p>Refunds are processed within 5-7 business days after we receive your return.</p>
                    <a href="#" class="btn btn-link p-0">Read More</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

