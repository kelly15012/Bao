@{
    ViewData["Title"] = "Visitor Landing Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .carousel-item img {
            height: 300px;
            object-fit: cover;
        }

        .carousel-caption {
            color: white;
            padding: 10px;
            border-radius: 15px;
        }

        .container-fluid {
            padding-right: 0;
            padding-left: 0;
        }

        .intro-section {
            padding-right: 0;
            padding-left: 0;
        }

            .intro-section h2 {
                margin-bottom: 20px;
            }

            .intro-section p {
                margin-bottom: 20px;
            }

        .text-lg-start {
            text-align: justify;
        }
    </style>
</head>
<body>
    <div class="container-fluid text-center">
        <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
            <ol class="carousel-indicators">
                <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active"></li>
                <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1"></li>
                <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2"></li>
            </ol>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img class="d-block w-100" src="~/image/baobg1.webp" style="filter: brightness(50%)" alt="Variety of Chinese Traditional Dim Sum">
                    <div class="carousel-caption d-none d-md-block mb-5">
                        <h1 class="mb-4"><strong>Welcome to Bao</strong></h1>
                        <p class="mb-4 d-none d-md-block"><strong>Register an Account and enjoy your time with Bao!</strong></p>
                        <a class="btn btn-secondary text-dark mt-2" asp-area="Identity" asp-page="/Account/Register">Register Now!</a> @* unable to link *@
                    </div>
                </div>
                <div class="carousel-item">
                    <img class="d-block w-100" src="~/image/baobg2.webp" alt="Family Enjoying Dim Sum">
                </div>
                <div class="carousel-item">
                    <img class="d-block w-100" src="~/image/baobg3.webp" alt="Chef Making XiaoLongBao">
                </div>
            </div>
            <a class="carousel-control-prev" data-bs-target="#carouselExampleIndicators" role="button" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
            </a>
            <a class="carousel-control-next" data-bs-target="#carouselExampleIndicators" role="button" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Next</span>
            </a>
        </div>
    </div>

    <div class="intro-section text-center">
        <div class="container mt-4">
            <div class="row justify-content-center">
                <div class="col-6 col mb-4">
                    <h2>About Us</h2>
                    <p class="text-lg-start" y">At Bao, we are delighted to bring you the authentic taste of traditional Chinese dim sum. Our menu features a variety of delectable dim sum dishes made from the freshest ingredients, including our famous pork buns, dumplings, and other savory treats. Whether you are here to enjoy a family meal, a casual lunch, or just to satisfy your cravings, we promise an exceptional culinary experience.</p>
                    <p class="text-lg-start">Register an account with us and stay updated on our latest offerings and promotions. We look forward to serving you!</p>
                    <a target="_blank" href="#" class="btn btn-primary">Learn More</a>
                </div>
                <div class="col-6 col mb-4">
                    <img class="d-block w-100" src="~/image/baobg2.webp">
                </div>
            </div>
        </div>
    </div>

    <div class="intro-section text-center">
        <div class="container mt-4">
            <div class="row justify-content-center">
                <div class="col-6 col mb-4">
                    <img class="d-block w-100" src="~/image/baobg3.webp">
                </div>
                <div class="col-6 col mb-4 ">
                    <h2>Visit Our Shop Now</h2>
                    <p class="text-lg-center text-dark fw-bolder">MORE EXCITING FOOD IS COMING SOON, STAY TUNED!</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Product" asp-action="ProdMenu">View Menu</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#carouselExampleIndicators').carousel({
                interval: 5000, // Slide interval in milliseconds
                ride: 'carousel'
            });
        });
    </script>
</body>
</html>