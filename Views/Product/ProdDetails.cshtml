@model Bao.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-5">
    <div class="row">
        <!-- Product Image Section -->
        <div class="col-md-6">
            <div class="product-detail">
                <img src="@(Model.CoverImage != null ? $"data:{Model.ContentType};base64,{Convert.ToBase64String(Model.CoverImage)}" : "https://via.placeholder.com/600x700")" alt="@Model.ProductName" class="img-fluid">
            </div>
        </div>
        <!-- Product Information Section -->
        <div class="col-md-6">
            <div class="product-info">
                <h1>@Model.ProductName</h1>
                <p class="text-muted">SKU: @Model.ProductId</p>
                <p>
                    <span class="text-danger">@Model.Price.ToString("C")</span>
                </p>
                <span class="badge badge-pill badge-info">@Model.Category?.categoryName</span>
                @if (!string.IsNullOrEmpty(Model.ProductDescription))
                {
                    <p class="card-text mt-2">@Model.ProductDescription</p>
                }
                <p class="card-text"><strong>Stock Available: </strong>@Model.Quantity</p>
                <p class="card-text"><strong>Status: </strong>@(Model.Status ? "Available" : "Unavailable")</p>
                <div class="d-flex flex-column mt-3">
                    <label for="quantity" class="form-label"><strong>Quantity:</strong></label>
                    <input type="number" id="quantity" class="form-control mb-3" min="1" max="@Model.Quantity" value="1" />
                    <button id="addToCartBtn1" class="btn btn-dark mb-3">Add to Cart</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $("#addToCartBtn1").click(function () {
                var quantity = $("#quantity").val();
                var productId = @Model.ProductId;

                $.ajax({
                    url: '@Url.Action("AddToCart1", "Product")',
                    type: 'POST',
                    data: {
                        id: productId,
                        quantity: quantity
                    },
                    success: function (result) {
                        alert("Product added to cart");
                    },
                    error: function () {
                        alert("Error adding product to cart");
                    }
                });
            });
        });
    </script>
}
