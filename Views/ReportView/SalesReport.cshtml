@model Bao.Models.SalesReportViewModel

@{
    ViewData["Title"] = "Sales Report";
}

<h2>@ViewData["Title"]</h2>

<form method="get" asp-action="SalesReport">
    <div class="form-group">
        <label for="startDate">Start Date:</label>
        <input type="date" id="startDate" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="form-group">
        <label for="endDate">End Date:</label>
        <input type="date" id="endDate" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <p class="mt-3">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="@Url.Action("ExportSalesReportToPdf", new { startDate = Model.StartDate, endDate = Model.EndDate })" class="btn btn-primary">Export to PDF</a>
    </p>
</form>


<table class="table table-striped">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Order Date</th>
            <th>Total Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ReportData)
        {
            <tr>
                <td>@item.OrderId</td>
                <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
                <td>@item.TotalAmount.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

<h2>Total Sales: @Model.TotalSales.ToString("C")</h2>

<p>
    <a href="@Url.Action("ProductSalesReport", new { startDate = Model.StartDate, endDate = Model.EndDate })" class="btn btn-primary">View Product Sales</a>
</p>