@model Bao.Models.Dashboard
@{
    ViewData["Title"] = "Manager Landing Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class=" bg-secondary container-fluid">
    <div class=" container text-lg-left py-3">
        <h1 class="display-4 py-3">Dashboard</h1>
    </div>
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h6 class="card-title">Total Users: </h6>
                        @* fetch data from database *@
                        <h2 id="totalUsers" class="card-text-custom">@Model.TotalUsers</h2>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h6 class="card-title">Total Orders of the day: </h6>
                        <h2 id="totalOrdersToday" class="card-text-custom">@Model.TotalOrdersToday</h2>
                        @* fetch data from database *@
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class=" container text-lg-center py-3">
        <h3 class="py-3">Manager Panel</h3>
    </div>
    <div class="row justify-content-start">
        <div class=".col-6 col mb-4">
            <div class="card bg-secondary text-dark">
                <h6 class="card-title-custom">Admin Management</h6>
            </div>
            <p class="container-custom justify-content-center">This section is for manage all the admin.</p>
            <div class="container-custom d-flex align-items-sm-center">
                <a class="btn btn-secondary-custom" asp-area="Identity" asp-page="/Account/AdminRegister">Add</a>
                <a class="btn btn-secondary-custom" asp-area="" asp-controller="ManagerAdminManagement" asp-action="AdminIndex">View</a>
            </div>
        </div>
        <div class=".col-6 col mb-4">
            <div class="card bg-secondary text-dark">
                <h6 class="card-title-custom">Reports</h6>
            </div>
            <p class="container-custom justify-content-center">This section is for you to view and generate reports.</p>
            <div class="container-custom d-flex align-items-sm-center">
                <a class="btn btn-secondary-custom" asp-area="" asp-controller="ReportView" asp-action="SalesReport">View Total Sales</a>
                <a class="btn btn-secondary-custom" asp-area="" asp-controller="ReportView" asp-action="ProductSalesReport">View Product Sales</a>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $.ajax({
            url: '@Url.Action("GetDashboardData", "Manager")',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                $('#totalUsers').text(data.TotalUsers);
                $('#totalOrdersToday').text(data.TotalOrdersToday);
            },
            error: function () {
                $('#totalUsers').text('Error');
                $('#totalOrdersToday').text('Error');
            }
        });
    });
</script>