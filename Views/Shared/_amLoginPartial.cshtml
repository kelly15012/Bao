@using Microsoft.AspNetCore.Identity
@using Bao.Areas.Identity.Data

@inject SignInManager<BaoUser> SignInManager
@inject UserManager<BaoUser> UserManager

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
<ul class="display: flex; flex-direction: column; align-items: flex-start; width: 100%;">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a id="manage" class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @UserManager.GetUserName(User)!</a>
        </li>
        <li class="nav-item">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="nav-link btn btn-secondary text-dark border-0">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item ">
            <a class="nav-link text-dark" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item" style="width: 70px">
            <a class="nav-link btn btn-secondary text-dark" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }

    @*     {
    Admin Vertical Navbar and Button
    <li class="nav-item ">
    <a class="nav-link text-dark" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
