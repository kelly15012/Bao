<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bao</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/_AdminLayout.css" asp-append-version="true">
    <link rel="stylesheet" href="~/Bao.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light fixed-top bg-white border-bottom box-shadow">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Manager" asp-action="mLanding">Manager</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark" href="#" id="staffManagementDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Staff Management</a>
                            <ul class="dropdown-menu" aria-labelledby="staffManagementDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="StaffManagement" asp-action="ManageStaff">Manage Staff</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="StaffManagement" asp-action="SchduleStaff">Schdule Staff</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="#" id="inventoryManagementDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Inventory Management</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="orderManagementDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Operations</a>
                            <ul class="dropdown-menu" aria-labelledby="orderManagementDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="OrderManagement" asp-action="ViewAllOrders">View All Orders</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="OrderManagement" asp-action="ResolveOrderIssues">Resolve Order Issues</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="reportsAnalyticsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Customer Relations</a>
                            <ul class="dropdown-menu" aria-labelledby="reportsAnalyticsDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="ReportsAnalytics" asp-action="GenerateReports">Generate Reports</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="ReportsAnalytics" asp-action="ViewAnalytics">View Analytics</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="#" id="promotionsDiscountsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Performance Monitoring</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container mt-2">
            <div class="row">
                <div class="col-md-6">
                    &copy; 2024 - Bao - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
                <div class="col-md-6 text-md-end">
                    <a href="#" class="me-4 text-dark">
                        <i class="fa-brands fa-facebook"></i>
                    </a>
                    <a href="#" class="me-4 text-dark">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                    <a href="#" class="me-4 text-dark">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                    <a href="#" class="me-4 text-dark">
                        <i class="fa-brands fa-x-twitter"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

