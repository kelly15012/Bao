<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bao</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/_AdminLayout.css" asp-append-version="true">
    <link rel="stylesheet" href="~/Bao.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>
<body>
    <div class="d-flex flex-row" style="width: 100vw; height: 100vh;">
    <div>
    <header>
        <nav class="navbar d-flex flex-column justify-content-around">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Admin" asp-action="aLanding">Admin</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                             <a class="nav-link text-dark" href="#" id="userManagementDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">User Management</a>
                        </li>
                        <li class="nav-item">
                             <a class="nav-link text-dark" href="#" id="menuManagementDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Menu Management</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="orderManagementDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Order Management</a>
                            <ul class="dropdown-menu" aria-labelledby="orderManagementDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="OrderManagement" asp-action="ViewAllOrders">View All Orders</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="OrderManagement" asp-action="ResolveOrderIssues">Resolve Order Issues</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="reportsAnalyticsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Reports and Analytics</a>
                            <ul class="dropdown-menu" aria-labelledby="reportsAnalyticsDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="ReportsAnalytics" asp-action="GenerateReports">Generate Reports</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="ReportsAnalytics" asp-action="ViewAnalytics">View Analytics</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                                    <a class="nav-link text-dark mb-5" href="#" id="promotionsDiscountsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Promotions and Discounts</a>
                        </li>
                    </ul>
                </div>
            </div>
                    <div class="w-100 mt-5 px-4">
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>
    </div>
    <div>

        <div class="container-fluid">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted">
            <div class="container mt-2">
                <div class="row">
                    <div class="col-md-6">
                        &copy; 2024 - Bao - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <a href="#" class="me-4 text-dark">
                            <i class="fa-brands fa-facebook"></i>
                        </a>
                        <a href="#" class="me-4 text-dark">
                            <i class="fa-brands fa-whatsapp"></i>
                        </a>
                        <a href="#" class="me-4 text-dark">
                            <i class="fa-brands fa-instagram"></i>
                        </a>
                        <a href="#" class="me-4 text-dark">
                            <i class="fa-brands fa-x-twitter"></i>
                        </a>
                    </div>
                </div>
            </div>
        </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

